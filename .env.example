# Database
DATABASE_URL="postgresql://user:password@localhost:5432/laughapp?schema=public"

# App
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3001"

# S3/Object Storage
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""

# Redis (optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
